{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": ".",
  "testEnvironment": "node",
  "testRegex": ".e2e-spec.ts$",
  "transform": {
    "^.+\\.(t|j)s$": "ts-jest"
  },
  "moduleNameMapper": {
    "^src/(.*)$": "<rootDir>/../src/$1",
    "^expo-server-sdk$": "<rootDir>/mocks/expo-server-sdk.ts",
    "^puppeteer-core$": "<rootDir>/mocks/puppeteer-core.ts"
  }
}
