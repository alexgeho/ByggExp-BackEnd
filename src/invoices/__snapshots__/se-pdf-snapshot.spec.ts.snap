      </div>
      <div>
        <b>Bankgiro</b>256-7030
      </div>
      <div>
        <b>Organisationsnr</b>559303-7566
        <b class="gap">Momsreg. nr</b>SE559303-756601
        <span class="gap">Godkänd för F-skatt</span>
      </div>
    </div>
  </div>
    </section>
  </main>
</body>
</html>"
