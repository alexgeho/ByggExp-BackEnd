exports[`SE PDF output is unchanged invoice — ROT, rounding, currency, QR 1`] = `
"<!DOCTYPE html>
<html lang="sv">
<head>
  <meta charset="utf-8" />
  <title>Faktura 39</title>
  <style>
@page { size: A4; margin: 0; }
* { box-sizing: border-box; }
html, body { margin: 0; padding: 0; }
body {
  font-family: Helvetica, Arial, sans-serif;
  font-size: 13px;
  line-height: 1.4;
  color: #1b1b1b;
  background: white;
}
.invoice-document { width: 210mm; margin: 0 auto; }
.invoice-page {
  width: 210mm;
  height: 297mm;
  min-height: 297mm;
  display: flex;
  flex-direction: column;
  page-break-after: always;
  overflow: hidden;
}
.invoice-page:last-child { page-break-after: auto; }
.invoice-page__header { padding: 14mm 16mm 0; }
.invoice-page__body { flex: 1; padding: 0 16mm; display: flex; flex-direction: column; }
.invoice-page__footer { padding: 0 16mm 8mm; }

/* ---- Header, measured off the invoice Geal sends today (Faktura 65):
   logo on the left half; the right column holds "Faktura", the meta pairs
   (indented) and the recipient, all on one left edge; "Sida" in the corner.
   The detail row below uses the same two columns, so "Vår referens" lines up
   under "Faktura". ---- */
.invoice-header__top {
  position: relative;
  display: grid;
  grid-template-columns: 373px 1fr;
  align-items: start;
}
.invoice-header__logo img { max-height: 120px; max-width: 290px; object-fit: contain; display: block; }
.invoice-header__sida { position: absolute; top: -10px; right: 0; font-size: 12px; color: #333; }
.invoice-header__title { font-size: 24px; font-weight: bold; margin: 12px 0 8px; }
.invoice-header__meta {
  display: grid;
  grid-template-columns: minmax(82px, max-content) max-content;
  column-gap: 10px;
  row-gap: 0;
  font-size: 13px;
  line-height: 1.3;
  margin: 0 0 16px 138px;
}
.invoice-header__meta dt { margin: 0; }
.invoice-header__meta dd { margin: 0; white-space: nowrap; }
.invoice-header__recipient { font-weight: normal; font-size: 13px; line-height: 1.3; }

.invoice-header__details {
  display: grid;
  grid-template-columns: 373px 1fr;
  align-items: start;
  margin: 80px 0 14px;
}
.invoice-header__details dl {
  display: grid;
  grid-template-columns: minmax(96px, max-content) max-content;
  column-gap: 10px;
  row-gap: 0;
  line-height: 1.3;
  font-size: 13px;
  margin: 0;
  align-content: start;
}
.invoice-header__details dt { margin: 0; }
.invoice-header__details dd { margin: 0; white-space: nowrap; }

/* ---- Line items: borderless, horizontal rules only ---- */
.invoice-lines {
  width: 100%;
  border-collapse: separate;
  border-spacing: 0;
  table-layout: fixed;
  align-self: stretch;
}
.invoice-lines thead th {
  text-align: left;
  font-weight: normal;
  padding: 8px 10px 9px;
  border-top: 1px solid #d5dae1;
  border-bottom: 1px solid #d5dae1;
  font-size: 13px;
  vertical-align: bottom;
}
.invoice-lines tbody td {
  padding: 14px 10px 0;
  font-size: 13px;
  vertical-align: top;
}
.invoice-lines__filler td { padding: 0; line-height: 0; border: none; }
.invoice-lines__footer td { vertical-align: bottom; border: none; padding: 0; }
.description { text-align: left; white-space: normal; word-break: break-word; }
.nowrap, .quantity, .unit, .amount { white-space: nowrap; }
.amount { font-variant-numeric: tabular-nums; }
.r { text-align: right; }
.reverse-note { font-size: 13px; padding: 12px 10px 0; }

/* ---- Summary band: note + rules + Exkl./Moms/Totalt/ATT BETALA ---- */
.invoice-summary-cell { padding: 0; }
.invoice-summary { width: 100%; }
.invoice-summary__note { font-size: 13px; padding: 0 10px 8px; line-height: 1.5; }
.invoice-summary__totals {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  border-top: 1px solid #d5dae1;
  padding: 8px 10px 10px;
  column-gap: 12px;
}
.invoice-summary__totals .lbl { font-size: 13px; font-weight: bold; padding-bottom: 2px; }
.invoice-summary__totals .val { font-size: 14px; white-space: nowrap; font-variant-numeric: tabular-nums; }
.invoice-summary__totals .att-lbl { text-align: right; }
.invoice-summary__totals .att-val { text-align: right; font-size: 15px; font-weight: bold; }
.invoice-summary__vat {
  display: grid;
  grid-template-columns: 1fr auto;
  border-top: 1px solid #d5dae1;
  padding: 8px 10px 0;
  font-size: 13px;
  column-gap: 16px;
}
.invoice-summary__vat .bank b { font-weight: bold; }
/* Payment QR sits to the left of the totals band, bottom-aligned with it. */
.invoice-summary__body { display: flex; align-items: flex-end; gap: 22px; }
.invoice-summary__main { flex: 1; }
.invoice-summary__qr { flex: 0 0 auto; text-align: center; padding: 0 0 2px 10px; }
.invoice-summary__qr img { width: 96px; height: 96px; display: block; }
.invoice-summary__qr span { display: block; font-size: 10.5px; color: #64748b; margin-top: 3px; }

/* ---- Footer ---- */
.invoice-footer {
  width: 100%;
  margin-top: 16px;
  display: flex;
  justify-content: space-between;
  gap: 16px;
  font-size: 12px;
  line-height: 1.5;
}
.invoice-footer b { display: block; }
.invoice-footer .gap { display: block; margin-top: 6px; }
</style>
</head>
<body>
  <main class="invoice-document">
    <section class="invoice-page">
      <div class="invoice-page__header">
    <header class="invoice-header">
      <!-- Top band: logo (left half) | title, meta, recipient (right column) -->
      <div class="invoice-header__top">
        <div class="invoice-header__logo"></div>
        <div>
          <div class="invoice-header__title">Faktura</div>
          <dl class="invoice-header__meta">
            <dt>Fakturadatum</dt><dd>2026-08-13</dd>
            <dt>Fakturanr</dt><dd>39</dd>
            
            <dt>OCR</dt><dd>398</dd>
          </dl>
          <div class="invoice-header__recipient">
            Svensson Fastigheter AB<br>
            Kungsportsavenyen 21<br>
            411 36 Göteborg
          </div>
        </div>
        <div class="invoice-header__sida">Sida 1(1)</div>
      </div>
      <!-- Detail row: customer refs | our refs, top-aligned -->
      <div class="invoice-header__details">
        <dl>
          <!-- As on the invoices Geal sends today: customer no, their order no,
               and the customer's VAT number (Maria, 2026-09-23). -->
          <dt>Kundnr</dt><dd>1001</dd>
          <dt>Er referens</dt><dd>Kalle</dd>
          <dt>Ert ordernr</dt><dd>PO-77</dd>
          <dt>Ert VAT-nummer</dt><dd>SE556677889901</dd>
        </dl>
        <dl>
          <dt>Vår referens</dt><dd>Maria</dd>
          <dt>Betalningsvillkor</dt><dd>30 dagar</dd>
          <dt>Förfallodatum</dt><dd class="nowrap">2026-09-12</dd>
          <dt>Dröjsmålsränta</dt><dd>8 %</dd>
        </dl>
      </div>
    </header>
  </div>
      <div class="invoice-page__body">
    <table class="invoice-lines" style="height:580px;">
      <colgroup>
        <col style="width: 9%;" />
        <col style="width: 39%;" />
        <col style="width: 14%;" />
        <col style="width: 10%;" />
        <col style="width: 13%;" />
        <col style="width: 15%;" />
      </colgroup>
      <thead>
        <tr>
          <th class="nowrap">Art.nr</th>
          <th class="description">Benämning</th>
          <th class="r nowrap quantity">Lev ant</th>
          <th class="nowrap unit">Enhet</th>
          <th class="r nowrap amount">À-pris</th>
          <th class="r nowrap amount">Summa</th>
        </tr>
      </thead>
      <tbody>
        
        <tr class="invoice-lines__item">
          <td class="nowrap">1</td>
          <td class="description">Arbete</td>
          <td class="r nowrap quantity">12,50</td>
          <td class="nowrap unit">h</td>
          <td class="r nowrap amount">495,00</td>
          <td class="r nowrap amount">6 187,50</td>
        </tr>
      
        <tr class="invoice-lines__item">
          <td class="nowrap">2</td>
          <td class="description">Material<br>rad två</td>
          <td class="r nowrap quantity">3,00</td>
          <td class="nowrap unit">st</td>
          <td class="r nowrap amount">1 234,50</td>
          <td class="r nowrap amount">3 333,15</td>
        </tr>
      
        <tr class="invoice-lines__item">
          <td class="nowrap">3</td>
          <td class="description">Böcker</td>
          <td class="r nowrap quantity">1,00</td>
          <td class="nowrap unit">st</td>
          <td class="r nowrap amount">99,00</td>
          <td class="r nowrap amount">99,00</td>
        </tr>
      
        <tr class="invoice-lines__item invoice-lines__text">
          <td></td>
          <td class="description" colspan="5">Tillkommande arbeten</td>
        </tr>
      
        <tr class="invoice-lines__filler" style="height:231px;"><td colspan="6"></td></tr>
      </tbody>
      
    <tfoot class="invoice-lines__footer">
      <tr>
        <td colspan="6" class="invoice-summary-cell">
          <div class="invoice-summary">
            <div class="invoice-summary__note" style="font-style: italic;">ROT-avdrag: personnr 19800101-1234, fastighet Bromma 1:23</div>
            <div class="invoice-summary__body">
              <div class="invoice-summary__qr"><img src="data:image/png;base64,QR" alt="" /><span>Skanna för att betala</span></div>
              <div class="invoice-summary__main">
                <div class="invoice-summary__totals">
                  <div>
                    <div class="lbl">Exkl. moms</div>
                    <div class="val">10 000,00</div>
                  </div>
                  <div>
                    <div class="lbl">Moms</div>
                    <div class="val">1 952,79</div>
                  </div>
                  <div>
                    <div class="lbl">Totalt</div>
                    <div class="val">12 500,00</div>
                  </div>
                  <div>
                    <div class="lbl att-lbl">ATT BETALA</div>
                    <div class="val att-val">SEK 11 000,00</div>
                  </div>
                </div>
                <div class="invoice-summary__vat">
                  <span>Moms 25% 1 546,88 (6 187,50)&nbsp;&nbsp;Moms 12% 399,98 (3 333,15)&nbsp;&nbsp;Moms 6% 5,94 (99,00)</span>
                  <span class="bank"><b>IBAN</b> SE45 5000 0000 0583 9825 7466&nbsp;&nbsp;<b>BIC</b> ESSESESS</span>
                </div>
              </div>
            </div>
          </div>
        </td>
      </tr>
    </tfoot>
  
    </table>
  </div>
      <div class="invoice-page__footer">
    <div class="invoice-footer">
      <div>
        <b>Adress</b>
        Geal Entreprenad AB<br>Byggmästarvägen 18<br>168 32 Bromma<br>Sverige
      </div>
      <div>
        <b>Telefon</b>+46707577574
        <b class="gap">E-post</b>mg@gealab.nu
