# Environment
# Every .env flavour, not just the bare name: a file called .env.bak.local was
# committed to this public repository with MONGODB_URI and JWT_SECRET inside,
# because the old rule matched one exact filename and nothing else.
.env
.env.*
!.env.example

# Dependencies
node_modules/

# Build output
dist/
/deploy

# Uploaded files
uploads/

# Logs
*.log
npm-debug.log*

# OS
.DS_Store

# IDE
.vscode/
